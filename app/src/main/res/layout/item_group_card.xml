<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/tally_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/tally_primary_light"
    app:strokeColor="@color/tally_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_group_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tally_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Cocoa Beach trip" />

            <TextView
                android:id="@+id/text_group_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/tally_text_secondary"
                android:textSize="11sp"
                tools:text="5 members · 12 expenses" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_group_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="+$62.50"
            tools:textColor="@color/tally_primary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
