<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tally_surface"
    tools:context=".JoinedEmptyStateActivity">

    <LinearLayout
        android:id="@+id/header_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/include_app_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_avatar_circle_gray"
                android:gravity="center"
                android:text="AL"
                android:textColor="@color/tally_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_avatar_circle_gray"
                android:gravity="center"
                android:text="EB"
                android:textColor="@color/tally_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_avatar_circle_gray"
                android:gravity="center"
                android:text="MA"
                android:textColor="@color/tally_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_avatar_circle_gray"
                android:gravity="center"
                android:text="JR"
                android:textColor="@color/tally_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_avatar_circle_gray"
                android:gravity="center"
                android:text="PS"
                android:textColor="@color/tally_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_member_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tally_text_secondary"
                android:textSize="11sp"
                tools:text="5 members" />
        </LinearLayout>

        <include
            android:id="@+id/group_tabs"
            layout="@layout/include_group_tabs" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_column">

        <TextView
            android:id="@+id/text_joined_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_filled"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="@color/tally_primary"
            android:textSize="12sp"
            tools:text="✓  You joined Cocoa Beach trip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_square_icon_gray"
                android:gravity="center"
                android:textColor="@color/tally_text_tertiary"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/empty_state_title"
                android:textColor="@color/tally_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/empty_state_body"
                android:textColor="@color/tally_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_first_expense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/tally_primary"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/action_add_first_expense"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_invite_more"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textAllCaps="false"
            android:textColor="@color/tally_text_primary"
            android:textSize="14sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/tally_border"
            tools:text="Invite more members · 4K9 · TQ2" />

    </LinearLayout>

    <include
        android:id="@+id/bottom_nav"
        layout="@layout/include_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
