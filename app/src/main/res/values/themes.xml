<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Tally" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/tally_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/tally_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/tally_primary</item>
        <item name="colorSecondary">@color/tally_primary</item>
        <item name="colorSurface">@color/tally_surface</item>
        <item name="colorOnSurface">@color/tally_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/tally_text_secondary</item>
        <item name="colorOutline">@color/tally_border</item>
        <item name="colorError">@color/tally_negative</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Tally" parent="Base.Theme.Tally" />
</resources>