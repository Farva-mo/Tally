<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Tally.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/tally_input_bg</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/tally_primary</item>
        <item name="hintTextColor">@color/tally_text_secondary</item>
    </style>

    <style name="Widget.Tally.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tally_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Tally.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/tally_surface</item>
        <item name="strokeColor">@color/tally_border</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">@color/tally_text_primary</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Tally.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Tally.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Tally.Tab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/tally_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.Tally.Tab.Selected">
        <item name="android:textColor">@color/tally_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Tally.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/tally_surface</item>
        <item name="strokeColor">@color/tally_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
